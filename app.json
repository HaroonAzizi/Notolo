{
  "expo": {
    "name": "Notolo",
    "slug": "notolo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071015"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "af.code.notolo",
      "backgroundColor": "#071015",
      "infoPlist": {
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071015",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "a31f0308-4bd5-4006-a406-670cc4f35ad1"
      }
    },
    "owner": "haroonazizi"
  }
}
